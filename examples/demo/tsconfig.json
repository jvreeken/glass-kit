{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "glass-kit": ["../../src/index.ts"],
      "glass-kit/styles.css": ["../../src/glass-kit.css"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
